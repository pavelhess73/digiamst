# Neon.tech Serverless PostgreSQL Connection String
# Získejte z Neon.tech konzole (Dashboard -> Quickstart / Connection Details)
# Příklad: postgresql://neondb_owner:npg_xyz@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ⚠️  POVINNÉ: Heslo pro přihlášení do administrace (/admin.html)
# Zvolte si silné heslo a zadejte ho jako proměnnou prostředí na Vercelu.
# BEZ TOHOTO NASTAVENÍ PŘIHLÁŠENÍ DO ADMINISTRACE NEBUDE FUNGOVAT.
ADMIN_PASSWORD=

# ⚠️  POVINNÉ: Tajný token pro admin session
# Zvolte si náhodný řetězec (např. vygenerujte na https://generate-secret.vercel.app/32)
ADMIN_TOKEN=

# ⚠️  POVINNÉ: Školní PIN kód pro přihlašovací formulář
# Tento kód sdělte žákům a rodičům (např. na třídní schůzce nebo v Bakalářích).
# Pokud není nastaven, použije se výchozí kód: AMSTERDAM2027
SCHOOL_PIN=

# Cloudflare Turnstile - ochrana formuláře před boty
# Site Key: zkopírujte z dash.cloudflare.com (Turnstile -> Your Site -> Site Key)
# Secret Key: zkopírujte z dash.cloudflare.com (Turnstile -> Your Site -> Secret Key)
#
# Testovací klíče (vždy fungují, pro lokální vývoj):
#   Site Key:   1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000AA
#
# Pro produkci nahraďte reálnými klíči!
TURNSTILE_SECRET_KEY=
